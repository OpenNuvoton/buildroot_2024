/dts-v1/;

/ {
	description = "MA35 FIT image for slot0";
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "Linux kernel for slot0";
			data = /incbin/("Image");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x80200000>;
			entry = <0x80200000>;
			image-version = LINUX_VERSION;
			hash-1 {
				algo = "sha256";
			};
		};

		fdt-1 {
			description = "Device tree for slot0";
			data = /incbin/("Image.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			hash-1 {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf-1";

		conf-1 {
			description = "Boot slot0";
			kernel = "kernel-1";
			fdt = "fdt-1";
			signature {
				algo = "sha256,rsa2048";
				key-name-hint = "dev";
				sign-images = "fdt", "kernel";
			};
		};
	};
};
